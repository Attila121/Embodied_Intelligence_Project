# Copy to rig/rig.env (ignored by Git) and fill in.  Plain KEY=value lines, no spaces around '='.

# --- required -------------------------------------------------------------------------
# ROS domain for the rig.  Must not be 30 (the simulation's domain).
RIG_ROS_DOMAIN_ID=
# 1 = this machine only (recommended for the dry run), 0 = visible on the network.
RIG_LOCALHOST_ONLY=1
# Two DIFFERENT attached Basler serials; list them with: python3 -c "from pypylon import pylon; print([d.GetSerialNumber() for d in pylon.TlFactory.GetInstance().EnumerateDevices()])"
HUMAN_CAMERA_SERIAL=
ROBOT_CAMERA_SERIAL=

# --- optional -------------------------------------------------------------------------
# Python used for the publishers and the checker.  It needs rclpy (source ROS), ultralytics,
# pypylon, opencv and numpy.  A venv created with --system-site-packages works.
# RIG_PYTHON=python3

# Override only if the files are not under rig/assets/ (see rig/assets/README.md).
# HUMAN_POSE_MODEL=
# HUMAN_CAP_MODEL=
# HUMAN_CALIB_DIR=
# ROBOT_MODEL=
# ROBOT_TOY_MODEL=
# ROBOT_CALIB_DIR=

# Tuning (defaults shown).
# CAP_CONF=0.3          # cap detector confidence threshold
# PROCESS_EVERY_N=1     # robot publisher: process every Nth acquired frame
# TOY_EVERY_N=4         # robot publisher: run the toy model every Nth processed frame
